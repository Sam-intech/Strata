// Cloudflare Containers deployment for the Strata API.
// A small Worker (worker/index.ts) receives requests and forwards them to the
// Python FastAPI container built from ./Dockerfile.
//
// Deploy:   npm install && npx wrangler deploy
// Secret:   npx wrangler secret put OPENAI_API_KEY   (optional — enables LLM explanations)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "strata-api",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "observability": { "enabled": true },

  "containers": [
    {
      "class_name": "StrataApi",
      "image": "./Dockerfile",
      // 1/4 vCPU, 1 GiB RAM — enough for pandas + scikit-learn + LangGraph
      "instance_type": "basic",
      "max_instances": 2
    }
  ],

  "durable_objects": {
    "bindings": [{ "class_name": "StrataApi", "name": "STRATA_API" }]
  },

  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StrataApi"] }],

  "vars": {
    // Browser origins allowed to call the API (comma-separated)
    "CORS_ORIGINS": "https://strata.samintech.dev"
  }
}
